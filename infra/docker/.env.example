# COOPECA — Variables d'environnement Docker Compose (DÉVELOPPEMENT LOCAL)
# Copier vers .env puis renseigner les valeurs locales.
# .env est ignoré par Git et ne doit JAMAIS contenir de secret réel versionné.

# --- PostgreSQL ---
POSTGRES_USER=coopeca
POSTGRES_PASSWORD=change-moi-mot-de-passe-local
POSTGRES_DB=coopeca

# --- API ---
JWT_SECRET=replace-this-development-secret-with-a-random-value